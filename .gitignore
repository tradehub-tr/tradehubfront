# ── Build Çıktıları ───────────────────────────────────────────────────────────
dist/
dist-ssr/
*.tsbuildinfo

# ── Bağımlılıklar ─────────────────────────────────────────────────────────────
node_modules
.cache/
.npm/
.eslintcache

# ── Environment Dosyaları ─────────────────────────────────────────────────────
# .env.development ve .env.production paylaşılabilir (localhost/build URL'leri)
# Sadece kişisel override dosyaları ignore edilir
.env
.env.local
.env.*.local

# ── Log Dosyaları ─────────────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ── Vite Geliştirme ───────────────────────────────────────────────────────────
*.local

# ── Editor / IDE ──────────────────────────────────────────────────────────────
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ── OS Dosyaları ──────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── Test / Coverage ───────────────────────────────────────────────────────────
coverage/

# ── Capacitor Native Projeleri ────────────────────────────────────────────────
# Native projeler ve build çıktıları repo dışında — `npx cap add` ile üretilir.
android/
ios/

# ── Auto Claude ───────────────────────────────────────────────────────────────
.auto-claude/
.auto-claude-security.json
.auto-claude-status
.claude_settings.json
.worktrees/
.security-key
logs/security/
.superpowers/
docs

# Playwright test artifacts
test-results/
playwright-report/
# Playwright kanıt çıktısı: her koşuda yeniden üretiliyor (443 dosya / 49 MB
# ölçüldü 31 Ağu). `evidence/*` biçimi bilinçli — `evidence/` yazsaydık git
# dizine hiç inmez ve aşağıdaki muafiyet çalışmazdı.
playwright/evidence/*
# İSTİSNA: medya görevlerinin BİLİNÇLİ commit'lediği görsel regresyon kanıtı
# (aca725f "kritik vitrin yollarına ekran ve video kanıtı ekle"). İzlenen tek
# kanıt kümesi bu; konvansiyon admin-panel'de de aynı.
!playwright/evidence/media-*/
# Görsel denetim çıktısı (GOREV-TAMAMLAMA-SOZLESMESI §2.5) — kaynak değil,
# teslim öncesi bakılıp atılan tur çıktısı.
tests/tools/gorseller/

# Tasarım mockup HTML'leri (lokal deneme dosyaları, repo'ya girmez)
public/mockups/

# Lighthouse ham raporları (özet .md tutulur, ham .html/.json yoksayılır)
perf-reports/*.report.html
perf-reports/*.report.json
perf-reports/bundle-stats.html
storybook-static/
