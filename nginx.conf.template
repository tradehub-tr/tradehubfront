# ── SEO ortam izolasyonu (FAIL-CLOSED) ─────────────────────────────
# ${FRONTEND_DOMAIN} envsubst ile render anında literal'e döner; map bir
# sabiti eşler. YALNIZ prod (istoc.com) boş header (= header basılmaz) ve
# Allow'lu robots dosyası alır. Env boş/yanlış/eksikse default = noindex +
# Disallow (staging'in yanlışlıkla indexlenmesi yerine prod'un yanlışlıkla
# deindeks olması tercih edilir — merge kapısı: compose-env FAZ A kanıtı).
map "${FRONTEND_DOMAIN}" $robots_tag {
    default     "noindex, nofollow";
    "istoc.com" "";
}
map "${FRONTEND_DOMAIN}" $robots_file {
    default     /robots-noindex.txt;
    "istoc.com" /robots-prod.txt;
}

# İçerik-hash'li adlandırma URL tahminini zorlaştırır ama tek başına yetmez:
# toplu tarama/enumeration denemeleri hız sınırlansın (limit_req).
# ÖLÇÜLDÜ (2026-08-31): eski 10r/s+burst20, medya panelinin sayfa başına
# ~50 eşzamanlı küçük resim isteğinde 48'in 27'sini 503'lüyordu — ekranda
# "kırık görsel" olarak görünüyordu. 30r/s+burst120 bir sayfalık görsel
# patlamasını geçirir; sürekli tarama yine sınırlı kalır. (2026-08-20: yerel üretilmiş şablondan buraya taşındı — kalıcı
# ev burası; gen-local-nginx.sh her koşuda yerel kopyayı bundan türetir.)
limit_req_zone $binary_remote_addr zone=files_zone:10m rate=30r/s;

# ── T-131 · Medya servis sertleştirmesi — başlık haritaları ─────────────────
# GERİ ALMA: bu map bloğunu ve /files/ + /private/files/ içindeki "T-131"
# işaretli blokları sil — başka hiçbir şey değişmedi.
# nginx boş değerli add_header'ı HİÇ basmaz → yalnız eşleşen uzantı başlık alır.
#
# SVG: backend zaten sanitize ediyor (reject_unsafe_files); edge yine de
# script yürütmeyi CSP sandbox ile keser (T-131 kabul kriteri: ayrı origin
# VEYA CSP sandbox). Yanıtın kendi CSP'si <img> içindeki render'ı ETKİLEMEZ —
# görsel teslimi bozulmaz; yalnız SVG'ye doğrudan gidilirse script çalışmaz.
map $uri $t131_files_csp {
    default   "";
    ~*\.svg$  "sandbox; default-src 'none'";
}
# HTML/JS-benzeri uzantı /files/ altından asla satır içi servis edilmez
# (T-131 kabul kriteri). Görüntü/video uzantıları BİLEREK listede YOK:
# görsele Content-Disposition: attachment basmak <img> teslimini riske atar.
map $uri $t131_files_dispo {
    default                                           "";
    ~*\.(html?|xhtml|shtml|xml|xsl|xslt|js|mjs|cjs)$  "attachment";
}

