# === ÜLKE TABLOSU SONU ===

# ── Ülke → sayfaya taşınacak değer (MOGEM-642) ────────────────────────────
# BOT MUAFİYETİ: arama motorlarına ülke verilmez. Googlebot ABD'den tarıyor;
# ona ülkeye göre farklı bir dil göstermek, indekslenen içeriği tarayıcının
# geldiği yere bağlar. Muafiyet sayesinde tarama davranışı bu özellikten
# ETKİLENMEZ — `$is_bot` map'i zaten yukarıda tanımlı.
map $is_bot $ulke_yayin {
    1       "";
    default $ulke_kodu;
}

# Çerez YALNIZ ülke biliniyorken yazılır. nginx boş değerli `add_header`ı hiç
# basmaz (config'in başka yerlerinde de kullanılan davranış), yani bilinmeyen
# IP'de ve botta hiçbir başlık eklenmez.
#
# Max-Age=3600: kullanıcı ağ değiştirince (mobil→ofis, VPN aç/kapa) tercih bir
# saat içinde kendini düzeltir. Daha uzun ömür, VPN'ini kapatan kullanıcıyı
# eski ülkesine kilitlerdi.
#
# `Secure` YOK: ülke kodu gizli bir değer değil ve http://localhost'ta
# `Secure` konursa tarayıcı çerezi sessizce atar, lokal geliştirme kırılır.
# (Dil tercihi çerezi `th-lang` ayrı ve orada `Secure` https'te ekleniyor.)
map $ulke_yayin $ulke_cerezi {
    ""      "";
    default "th-country=$ulke_yayin; Path=/; Max-Age=3600; SameSite=Lax";
}

# Çerez SADECE HTML yanıtlarında. Neden içerik tipine göre süzülüyor:
# `add_header` server seviyesinde duruyor (aşağıdaki not), yani süzgeç
# olmasaydı her .js/.css/.woff2 yanıtına da eklenirdi — sayfa başına ~50
# istek × ~60 bayt, karşılığında hiçbir kazanç yok.
# Teşhis ucu için: ziyaretçide ZATEN bir dil tercihi var mı?
# `$cookie_th_lang` ÇALIŞMAZ — nginx `$cookie_*` önekinde çerez adını birebir
# arar ve değişken adları tire taşıyamaz, yani tireli `th-lang` okunamaz
# (ölçüldü 17 Eyl 2026: alan boş dönüyordu). Ham `$http_cookie` dönmek de
# yanlış olurdu: oturum çerezleri dahil her şeyi sızdırırdı. Regex ile
# yalnız ihtiyacımız olan iki değer çekiliyor.
map $http_cookie $gelen_dil_cerezi {
    # Desen TIRNAK İÇİNDE olmak zorunda: `{}` ve `;` nginx'te blok ayracı,
    # tırnaksız yazılınca "invalid number of the map parameters" veriyor
    # (ölçüldü 17 Eyl 2026). Desende `$` de kullanılmıyor — tırnak içinde
    # değişken genişletmesiyle karışmasın.
    "~*(?:^|; *)th-lang=([a-z]{2})" $1;
    default                         "";
}
map $http_cookie $gelen_dil_kaynagi {
    "~*(?:^|; *)th-lang-source=([a-z]+)" $1;
    default                              "";
}

map $sent_http_content_type $ulke_cerezi_html {
    ~*text/html $ulke_cerezi;
    # BOŞ içerik tipi de kabul: 304 Not Modified yanıtlarında nginx
    # `Content-Type` göndermiyor, bu yüzden yalnız `text/html` süzgeci
    # kullanılınca çerez 304'lerde HİÇ yazılmıyordu (ölçüldü 17 Eyl 2026).
    # Etkisi görünürdü: çerez ömrü (1 saat) dolduktan sonra dönen ve HTML'i
    # önbellekten doğrulayan ziyaretçi ülkesiz kalıyordu. Karşılığında
    # hash'li varlıkların 304'lerine de çerez ekleniyor — onlar `immutable`
    # olduğu için 304 zaten nadir, maliyeti birkaç bayt.
    ""          $ulke_cerezi;
    default     "";
}

server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;

    # ── GERÇEK ZİYARETÇİ IP'Sİ (MOGEM-642) ────────────────────────────────
    # TLS Caddy'de bitiyor ve istek buraya 80 portundan geliyor; bu yüzden
    # `$remote_addr` Caddy'nin adresidir, ziyaretçinin değil. Gerçek IP
    # `X-Forwarded-For` ile geliyor — ALPHA'da ölçüldü (17 Eyl 2026):
    # Caddy container'a 192.168.144.1'den bağlanıyor ve XFF'te ziyaretçinin
    # genel IP'si birebir geliyor.
    #
    # GÜVEN SINIRI DAR: yalnız özel adres aralıklarına güvenilir. Container
    # portu dışarıya açık olduğu için biri Caddy'yi atlayıp doğrudan bağlanıp
    # sahte bir XFF gönderebilir; ama o bağlantının kaynak adresi GENEL olur,
    # aşağıdaki listede bulunmaz ve nginx başlığı YOK SAYAR. Sahtecilik
    # yapısal olarak kapalı.
    #
    # Tek IP yerine aralık yazılmasının sebebi: docker ağları yeniden
    # oluşturulduğunda geçit adresi değişebiliyor (192.168.144.1 → başka).
    # Tek adrese bağlansaydık, ağ yenilendiği gün ülke tespiti sessizce
    # ölür ve herkes tarayıcı diline düşerdi.
    set_real_ip_from 10.0.0.0/8;
    set_real_ip_from 172.16.0.0/12;
    set_real_ip_from 192.168.0.0/16;
    set_real_ip_from 127.0.0.1;
    real_ip_header   X-Forwarded-For;
    real_ip_recursive on;

    # www → apex 301 — container savunma katmanı (birincil mekanizma Sunucu B
    # host-nginx vhost'u). Staging'de www.<env> DNS'i yok → koşul hiç tutmaz.
    if ($host = "www.${FRONTEND_DOMAIN}") {
        return 301 https://${FRONTEND_DOMAIN}$request_uri;
    }

    # ── Sıkıştırma — metin tabanlı asset'lerin transfer boyutunu ~%75 düşürür.
    gzip on;
    gzip_vary on;
    gzip_comp_level 6;
    gzip_min_length 1024;
    gzip_proxied any;
    gzip_types
        text/plain
        text/css
        text/javascript
        application/javascript
        application/json
        application/manifest+json
        application/xml
        text/xml
        image/svg+xml;

    # ── SEO: ortam-koşullu X-Robots-Tag (map $robots_tag) ─────────
    # Prod'da değer boş → nginx header'ı HİÇ basmaz; diğer tüm ortamlarda
    # noindex. NOT (add_header miras tuzağı): kendi add_header'ı olan
    # location'lar (/api/, /assets/, resim regex'i) bu header'ı MİRAS ALMAZ —
    # o bloklara ayrıca eklendi. check-nginx-noindex.sh sayım assert'i: 4.
    add_header X-Robots-Tag $robots_tag always;

    # ── Güvenlik header'ları ──────────────────────────────────────
    add_header X-Frame-Options "DENY" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-XSS-Protection "1; mode=block" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;

    # ── Ülke çerezi (MOGEM-642) ───────────────────────────────────────────
    # NEDEN SERVER SEVİYESİNDE, `location /` İÇİNDE DEĞİL: `location /` bloğunda
    # hiç `add_header` yok; oraya bir tane eklemek nginx'in miras kuralı gereği
    # YUKARIDAKİ BAŞLIKLARIN TAMAMINI (CSP, HSTS, X-Frame-Options,
    # X-Content-Type-Options, Referrer-Policy, Permissions-Policy, X-Robots-Tag)
    # o location için düşürürdü. Ölçüldü 17 Eyl 2026: server seviyesinde +
    # içerik tipi süzgeciyle hem çerez HTML'e yazılıyor hem başlıklar duruyor.
    add_header Set-Cookie $ulke_cerezi_html always;
    # Consent sonrası GTM container'ının yüklediği GA4, Clarity ve Yandex
    # Metrica kaynakları açıkça izinli. frame-src GTM fallback iframe'ini,
    # child/frame blob izinleri ise Metrica Webvisor'u destekler.
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://*.googletagmanager.com https://*.clarity.ms https://mc.yandex.ru https://yastatic.net; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self' https://${BACKEND_DOMAIN} wss://${BACKEND_DOMAIN} https://*.googletagmanager.com https://*.google-analytics.com https://*.analytics.google.com https://www.google.com https://*.clarity.ms https://c.bing.com https://mc.yandex.ru https://mc.yandex.az https://mc.yandex.by https://mc.yandex.co.il https://mc.yandex.com https://mc.yandex.com.am https://mc.yandex.com.ge https://mc.yandex.com.tr https://mc.yandex.ee https://mc.yandex.fr https://mc.yandex.kg https://mc.yandex.kz https://mc.yandex.lt https://mc.yandex.lv https://mc.yandex.md https://mc.yandex.tj https://mc.yandex.tm https://mc.yandex.uz https://mc.webvisor.com https://mc.webvisor.org wss://mc.yandex.ru wss://mc.yandex.az wss://mc.yandex.by wss://mc.yandex.co.il wss://mc.yandex.com wss://mc.yandex.com.am wss://mc.yandex.com.ge wss://mc.yandex.com.tr wss://mc.yandex.ee wss://mc.yandex.fr wss://mc.yandex.kg wss://mc.yandex.kz wss://mc.yandex.lt wss://mc.yandex.lv wss://mc.yandex.md wss://mc.yandex.tj wss://mc.yandex.tm wss://mc.yandex.uz wss://mc.webvisor.com wss://mc.webvisor.org; frame-src https://www.googletagmanager.com blob: https://mc.yandex.ru; child-src blob: https://mc.yandex.ru; worker-src 'self'; frame-ancestors 'none';" always;

    # Hayalet path kararı: /markalar kaybetti → kalıcı 301 /ureticiler
    # (nginx map + backend static_pages_registry + FE listesi senkron).
    #
    # Location MUTLAK ve https (2026-09-21): göreli `return 301 /x` yazılırsa
    # nginx adresi `$scheme` ile kurar; Caddy arkasında `$scheme=http` olduğu
    # için tarayıcı önce http'ye gider ve Caddy'nin 308'iyle İKİNCİ bir hop
    # yaşanır. Ölçüldü (21 Eyl, canlı): bu kural
    # `location: http://istoc.com/ureticiler` döndürüyordu.
    location = /markalar {
        return 301 https://$host/ureticiler;
    }

    # ── Eski `/en/...` dil öneki → kalıcı 301 (şema 2026-09-21'de söküldü) ──
    #
    # NEDEN: şema yazılmıştı ama HİÇ SUNULMUYORDU. Ölçüldü (2026-09-21, canlı):
    # `/en/kategori/<slug>` → 404, `/en/` → 404; buna karşılık beş site haritası
    # toplam 25.997 adet `hreflang="en"` alternate'i Google'a bildiriyordu
    # (products 2.431 · categories 23.511 · brands 3 · sellers 28 · static 24).
    # Google kırık alternate'i yok sayar, Search Console'da hata olarak
    # raporlar ve tekrarlanan 404'ler tarama bütçesini yer.
    #
    # KARAR (K7, yönetici): yol öneki kullanılmayacak, dil `?hl=` ile taşınacak
    # ve tercih çerezde kalıcı olacak. İndekste kalan eski adresler burada
    # kapanıyor: hem doğru sayfaya hem doğru dile gidiyor.
    #
    # Location MUTLAK ve `https`: göreli `return 301 /x` yazılırsa nginx adresi
    # `$scheme` ile kurar; Caddy arkasında `$scheme=http` olduğu için tarayıcı
    # önce http'ye gider ve Caddy'nin 308'iyle İKİNCİ bir hop yaşanır. Ölçüldü
    # (2026-09-21): mevcut `/markalar` kuralı `location: http://istoc.com/ureticiler`
    # döndürüyor. 25.997 adresi ilgilendiren bir kuralda o hop ücretsiz değil.
    #
    # `rewrite ... permanent` orijinal query string'i `hl=en`in ARDINA ekler
    # (nginx davranışı), yani `?sayfa=2` gibi parametreler kaybolmaz.
    location = /en {
        return 301 https://$host/?hl=en;
    }
    location = /en/ {
        return 301 https://$host/?hl=en;
    }
    location ^~ /en/ {
        rewrite ^/en/(.*)$ https://$host/$1?hl=en permanent;
    }

    # sell-pricing sayfası kaldırıldı: fiyat planları artık /satici-ol'da
    # (#paketler bölümü). Eski pretty URL + ham HTML path kalıcı 301.
    # (nginx map + backend static_pages_registry + FE listesi senkron).
    location = /satici/fiyatlandirma {
        return 301 https://$host/satici-ol;
    }
    location = /pages/seller/sell-pricing.html {
        return 301 https://$host/satici-ol;
    }

    # ── robots.txt — ortama göre statik dosya (map $robots_file) ──
    # İki dosya da dist'te (public/robots-*.txt): string-escape/newline tuzağı
    # yok, map yalnız hangi dosyanın servis edileceğini seçer. Prod gövdesine
    # Sitemap satırı BE-MAP canlıya çıkınca eklenir (404 sitemap ilan etme).
    location = /robots.txt {
        try_files $robots_file =404;
    }

    # ── DİL TEŞHİS UCU (MOGEM-642) ────────────────────────────────
    # "Rusya'dan bağlandım ama Rusça gelmedi" sorusunu tahminle değil KANITLA
    # cevaplamak için. Sunucunun o istek hakkında GÖRDÜĞÜ her şeyi döner.
    #
    # Faz 0'daki işi: Caddy'nin gerçek ziyaretçi IP'sini `X-Forwarded-For` ile
    # gönderip göndermediğini ölçmek. Bütün ülke tespiti buna dayanıyor; XFF
    # gelmiyorsa nginx herkesi Caddy'nin özel IP'si olarak görür ve hiçbir
    # ülke eşleşmez. Ölçülmeden tablo yazmak temeli görmeden ev dikmektir.
    #
    # Gizlilik: yalnız ÇAĞIRANIN KENDİ isteğine ait değerler döner; başka
    # kullanıcının verisi yok, oturum/çerez içeriği yok.
    #
    # add_header miras tuzağı (bkz. server bloğundaki not): bu blok kendi
    # add_header'ını tanımladığı için server seviyesindekileri MİRAS ALMAZ —
    # gerekli üçü burada tekrar yazıldı.
    location = /__dil-teshis {
        default_type application/json;
        # `ulke` = tablonun bulduğu ülke · `ulke_yayin` = bota muafiyet
        # uygulandıktan SONRAKİ değer (bot ise boş). İkisi ayrı dönüyor ki
        # "neden ülkem görünüyor ama dil değişmedi" sorusu ayırt edilebilsin.
        add_header X-Robots-Tag "noindex, nofollow" always;
        add_header Cache-Control "no-store" always;
        add_header X-Content-Type-Options "nosniff" always;
        return 200 '{"surum":"$dil_teshis_surumu","gorulen_ip":"$remote_addr","xff":"$http_x_forwarded_for","proto":"$http_x_forwarded_proto","host":"$host","bot":"$is_bot","ulke":"$ulke_kodu","ulke_yayin":"$ulke_yayin","gelen_dil_cerezi":"$gelen_dil_cerezi","gelen_kaynak":"$gelen_dil_kaynagi"}';
    }

    # ── PWA manifest — nginx mime.types'ta .webmanifest yok, varsayılan
    # application/octet-stream ile gidiyordu (Lighthouse "manifest" uyarısı).
    # add_header YOK: server-level X-Robots-Tag miras kalsın.
    location = /manifest.webmanifest {
        default_type application/manifest+json;
        try_files $uri =404;
    }

    # ── sitemap.xml — backend proxy (BE-MAP canlıya çıkana kadar bilinçli 404)
    location = /sitemap.xml {
        proxy_hide_header X-Robots-Tag;
        proxy_set_header X-Istoc-Storefront "1";
        proxy_pass https://${BACKEND_DOMAIN}/api/method/tradehub_core.api.seo.get_sitemap_index;
        proxy_ssl_server_name on;
        proxy_set_header Host ${BACKEND_DOMAIN};
        proxy_set_header X-Country "";
        proxy_set_header CF-IPCountry "";
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
    }
    location ~ ^/sitemap-([a-z0-9-]+)\.xml$ {
        proxy_hide_header X-Robots-Tag;
        proxy_set_header X-Istoc-Storefront "1";
        proxy_pass https://${BACKEND_DOMAIN}/api/method/tradehub_core.api.seo.get_sitemap?name=$1;
        proxy_ssl_server_name on;
        proxy_set_header Host ${BACKEND_DOMAIN};
        proxy_set_header X-Country "";
        proxy_set_header CF-IPCountry "";
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
    }

    # Stable asset identity landing page. Dosya teslim URL'sinden ayrıdır;
    # metadata/dosya adı değişse de Media Asset kimliği sabit kalır.
    location ~ ^/media/([a-zA-Z0-9_-]+)$ {
        proxy_hide_header X-Robots-Tag;
        proxy_set_header X-Istoc-Storefront "1";
        proxy_pass https://${BACKEND_DOMAIN}/api/method/tradehub_core.api.media_public.asset_landing?asset_id=$1;
        proxy_ssl_server_name on;
        proxy_set_header Host ${BACKEND_DOMAIN};
        proxy_set_header X-Country "";
        proxy_set_header CF-IPCountry "";
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Medya izleme sayfası (Task 4, 2026-08-26 medya-watch-page). Yukarıdaki
    # /media/<id> bloğuyla BİREBİR desen — bot/insan ayrımı YOK (diğer
    # /urun,/kategori,/marka,/magaza SEO bloklarından farklı): eski slug'ların
    # 301 köprüsü ve bilinmeyen slug'ın 404'e düşmesi gerçek kullanıcılar için de
    # geçerli olmalı, bu yüzden TÜM istekler resolver'a gider (page_resolver.
    # render_media_watch dist'teki pages/media-watch.html'i okuyup <head>'e SEO
    # enjekte eder, gövde/script olduğu gibi döner — sayfa yine client'ta çizilir).
    location ~ ^/medya/v/([a-z0-9-]+)$ {
        proxy_hide_header X-Robots-Tag;
        proxy_set_header X-Istoc-Storefront "1";
        proxy_pass https://${BACKEND_DOMAIN}/api/method/tradehub_core.seo.page_resolver.render_media_watch?slug=$1;
        proxy_ssl_server_name on;
        proxy_set_header Host ${BACKEND_DOMAIN};
        proxy_set_header X-Country "";
        proxy_set_header CF-IPCountry "";
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Frappe API proxy
    location /api/ {
        # CORS — whitelist: GitHub Pages, *.istoc.com subdomain'leri, Capacitor WebView (iOS/Android).
        # Regex ile m/app/preview/admin-preview.istoc.com toplu eşleşme.
        set $cors_origin "";
        if ($http_origin = "https://tradehub-tr.github.io") {
            set $cors_origin $http_origin;
        }
        if ($http_origin ~ "^https://(m|app|preview|admin-preview)\.istoc\.com$") {
            set $cors_origin $http_origin;
        }
        # Capacitor native WebView (iOS https scheme + iosScheme: 'https')
        if ($http_origin = "https://localhost") {
            set $cors_origin $http_origin;
        }
        # Capacitor varsayılan scheme (eski versiyonlar veya fallback)
        if ($http_origin = "capacitor://localhost") {
            set $cors_origin $http_origin;
        }
        add_header Access-Control-Allow-Origin $cors_origin always;
        add_header Access-Control-Allow-Credentials "true" always;
        add_header Access-Control-Allow-Methods "GET, POST, PUT, DELETE, OPTIONS, PATCH" always;
        add_header Access-Control-Allow-Headers "Content-Type, X-Frappe-CSRF-Token, Authorization" always;
        # Miras tuzağı: bu blok kendi add_header'larını tanımladığı için
        # server-level X-Robots-Tag buraya inmez — açıkça tekrarlanır.
        add_header X-Robots-Tag $robots_tag always;

        # Preflight OPTIONS
        if ($request_method = OPTIONS) {
            return 204;
        }

        # Backend'den gelen CORS header'larını sil (çift değer olmasın)
        proxy_hide_header Access-Control-Allow-Origin;
        proxy_hide_header Access-Control-Allow-Credentials;
        proxy_hide_header Access-Control-Allow-Methods;
        proxy_hide_header Access-Control-Allow-Headers;
        # Backend'in (noindex_guard) X-Robots-Tag'i edge'e sızmasın — header
        # politikasının tek sahibi bu nginx'tir.
        proxy_hide_header X-Robots-Tag;

        proxy_pass https://${BACKEND_DOMAIN}/api/;
        proxy_cookie_domain ${BACKEND_DOMAIN} ${FRONTEND_DOMAIN};
        proxy_cookie_flags ~ SameSite=None Secure;
        proxy_ssl_server_name on;
        proxy_set_header Host ${BACKEND_DOMAIN};
        # ── Ülke başlığı: BOŞ DEĞİL, nginx'in ÜRETTİĞİ değer (MOGEM-642, 21 Eyl) ──
        #
        # Faz 1.4'te (16 Eyl) bu satır güvenlik için boşaltılmıştı: istemci
        # `X-Country: US` gönderip kendi ülkesini uydurabiliyordu. O günkü not
        # aynen şöyleydi: *"ülke kodunun nereden geleceğine karar VERİLMEDİ;
        # o karar geldiğinde başlığı dolduran kaynak buraya eklenecek."*
        # Karar 17 Eyl'de verildi (M1: nginx `geo`) ama başlık doldurulmadı.
        #
        # ÖLÇÜLDÜ (21 Eyl, alpha, gerçek yabancı IP'ler): dil ile para birimi
        # AYNI ANDA farklı ülke görüyordu — Türkiye IP'sinde dil `TR`, para
        # birimi `US`/USD. Sebep: `api/currency.py::_detect_country()` ülkeyi
        # `CF-IPCountry` → `X-Country` → `Accept-Language` sırasıyla okuyor;
        # ilk ikisi boş gelince tarayıcı diline düşüyordu. Yani Türkiye'deki
        # İngilizce tarayıcılı kullanıcı arayüzü Türkçe, fiyatları USD görüyordu.
        #
        # GÜVENLİK KAZANIMI KAYBOLMUYOR: `proxy_set_header` istemciden geleni
        # EZER; değeri nginx üretiyor, ziyaretçi değil.
        #
        # `$ulke_kodu` DEĞİL `$ulke_yayin`: ikincisi bot muafiyetini taşıyor
        # (arama motoruna ülke verilmez). Dil tarafı da aynı değişkeni kullanıyor,
        # yani iki özellik ayrışamaz.
        #
        # `CF-IPCountry` BOŞ KALIYOR: Cloudflare M1 ile elendi, o başlık artık
        # hiçbir yerden gelmiyor. Backend onu ÖNCE okuduğu için boş bırakmak
        # zorunlu — dolu bırakılsaydı istemci yine ülkesini uydurabilirdi.
        proxy_set_header X-Country $ulke_yayin;
        proxy_set_header CF-IPCountry "";
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
    }

    # Private files — Frappe permission-checked download (identity docs etc.)
    # ^~ ZORUNLU: aşağıdaki resim-uzantı regex'i (~* \.(png|jpg…)$) bu prefix'i
    # ezmesin diye. ^~ olmadan /private/files/x.jpg backend yerine regex'e düşer.
    location ^~ /private/files/ {
        # ── T-131 · Medya servis sertleştirmesi (tek blok — geri almak için sil)
        # DİKKAT: bloğa add_header girince server-level başlık mirası kesilir;
        # önceki davranışı korumak için o başlıklar burada açıkça tekrarlanır.
        # Tek bilinçli fark site CSP'si: script-src 'unsafe-inline' içerdiği
        # için SVG'de inline script'e İZİN VERİRDİ — yerine koşullu sandbox.
        add_header X-Robots-Tag $robots_tag always;
        add_header X-Frame-Options "DENY" always;
        add_header X-XSS-Protection "1; mode=block" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
        proxy_hide_header X-Content-Type-Options;
        add_header X-Content-Type-Options "nosniff" always;
        proxy_hide_header Content-Security-Policy;
        add_header Content-Security-Policy $t131_files_csp always;
        add_header Content-Disposition $t131_files_dispo always;
        # ── /T-131 ──
        proxy_hide_header X-Robots-Tag;
        proxy_pass https://${BACKEND_DOMAIN}/private/files/;
        proxy_ssl_server_name on;
        proxy_set_header Host ${BACKEND_DOMAIN};
        proxy_set_header X-Country "";
        proxy_set_header CF-IPCountry "";
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Public files (product images etc.)
    # ^~ ZORUNLU: resim-uzantı regex'i (~* \.(png|jpg…)$) bu prefix'i ezmesin.
    # ^~ olmadan /files/urun.jpg backend'e gitmez, regex'e düşer → 404.
    location ^~ /files/ {
        # noindex + limit_req (2026-08-20: yerel kopyadan kalıcı eve taşındı):
        # içerik-hash'li olsa da URL indexlenmesin; enumeration yavaşlasın.
        # burst=20 nodelay sayfadaki paralel görsel isteklerini engellemez.
        add_header X-Robots-Tag "noindex" always;
        limit_req zone=files_zone burst=120 nodelay;

        # ── T-131 · Medya servis sertleştirmesi (tek blok — geri almak için sil)
        # nosniff'i bugüne dek yalnız upstream basıyordu; edge sahiplensin:
        # çift başlık olmasın diye önce gizle, tek doğruyu bas.
        proxy_hide_header X-Content-Type-Options;
        add_header X-Content-Type-Options "nosniff" always;
        proxy_hide_header Content-Security-Policy;
        add_header Content-Security-Policy $t131_files_csp always;
        add_header Content-Disposition $t131_files_dispo always;
        # ── /T-131 ──
        proxy_hide_header X-Robots-Tag;
        proxy_pass https://${BACKEND_DOMAIN}/files/;
        proxy_ssl_server_name on;
        proxy_set_header Host ${BACKEND_DOMAIN};
        proxy_set_header X-Country "";
        proxy_set_header CF-IPCountry "";
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # File upload size limit
    client_max_body_size 50m;

    # Vite build assets — önce lokal dosyaya bak, yoksa Frappe'ye proxy et.
    # Hash'li dosya isimleri (style-M3JxMgvs.css) içeriğe bağlı → içerik
    # değişince isim değişir. Bu yüzden immutable + 1 yıl cache güvenli;
    # "Efficient cache lifetimes" (3MB) denetimini tamamen kapatır.
    # ^~ ZORUNLU: /assets/ içinde .svg/.png/.woff2 gibi uzantılar resim regex'ine
    # düşmesin; bu blok zaten @frappe_assets fallback'i ile backend'e gidiyor.
    location ^~ /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        add_header X-Robots-Tag $robots_tag always;
        try_files $uri @frappe_assets;
    }
    location @frappe_assets {
        proxy_hide_header X-Robots-Tag;
        proxy_pass https://${BACKEND_DOMAIN};
        proxy_ssl_server_name on;
        proxy_set_header Host ${BACKEND_DOMAIN};
        proxy_set_header X-Country "";
        proxy_set_header CF-IPCountry "";
    }

    # Socket.IO WebSocket proxy
    location /socket.io/ {
        proxy_hide_header X-Robots-Tag;
        proxy_pass https://${BACKEND_DOMAIN}/socket.io/;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_ssl_server_name on;
        proxy_set_header Host ${BACKEND_DOMAIN};
        proxy_set_header X-Country "";
        proxy_set_header CF-IPCountry "";
    }

    # Dinamik SEO URL'leri — bot: backend'den meta injection, user: lokal HTML
    location ~ ^/urun/(.+)$ {
        error_page 418 = @seo_listing;
        if ($is_bot) { return 418; }
        rewrite ^ /pages/product-detail.html break;
    }
    location @seo_listing {
        internal;
        rewrite ^/urun/(.+)$ /api/method/tradehub_core.seo.page_resolver.render_listing?slug=$1 break;
        # Paylaşım önizlemesinde müşteri backend domaini görmesin (canonical/og:url → ${FRONTEND_DOMAIN}).
        proxy_set_header Accept-Encoding "";
        sub_filter "${BACKEND_DOMAIN}" "${FRONTEND_DOMAIN}";
        sub_filter_once off;
        proxy_hide_header X-Robots-Tag;
        proxy_set_header X-Istoc-Storefront "1";
        proxy_pass https://${BACKEND_DOMAIN};
        proxy_ssl_server_name on;
        proxy_set_header Host ${BACKEND_DOMAIN};
        proxy_set_header X-Country "";
        proxy_set_header CF-IPCountry "";
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
    }

    location ~ ^/kategori/(.+)$ {
        error_page 418 = @seo_category;
        if ($is_bot) { return 418; }
        rewrite ^ /pages/categories.html break;
    }
    location @seo_category {
        internal;
        rewrite ^/kategori/(.+)$ /api/method/tradehub_core.seo.page_resolver.render_category?slug=$1 break;
        # Paylaşım önizlemesinde müşteri backend domaini görmesin (canonical/og:url → ${FRONTEND_DOMAIN}).
        proxy_set_header Accept-Encoding "";
        sub_filter "${BACKEND_DOMAIN}" "${FRONTEND_DOMAIN}";
        sub_filter_once off;
        proxy_hide_header X-Robots-Tag;
        proxy_set_header X-Istoc-Storefront "1";
        proxy_pass https://${BACKEND_DOMAIN};
        proxy_ssl_server_name on;
        proxy_set_header Host ${BACKEND_DOMAIN};
        proxy_set_header X-Country "";
        proxy_set_header CF-IPCountry "";
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
    }

    location ~ ^/marka/(.+)$ {
        error_page 418 = @seo_brand;
        if ($is_bot) { return 418; }
        rewrite ^ /pages/brand.html break;
    }
    location @seo_brand {
        internal;
        rewrite ^/marka/(.+)$ /api/method/tradehub_core.seo.page_resolver.render_brand?slug=$1 break;
        # Paylaşım önizlemesinde müşteri backend domaini görmesin (canonical/og:url → ${FRONTEND_DOMAIN}).
        proxy_set_header Accept-Encoding "";
        sub_filter "${BACKEND_DOMAIN}" "${FRONTEND_DOMAIN}";
        sub_filter_once off;
        proxy_hide_header X-Robots-Tag;
        proxy_set_header X-Istoc-Storefront "1";
        proxy_pass https://${BACKEND_DOMAIN};
        proxy_ssl_server_name on;
        proxy_set_header Host ${BACKEND_DOMAIN};
        proxy_set_header X-Country "";
        proxy_set_header CF-IPCountry "";
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
    }

    # Seller shop (mağaza dükkânı) — frontend SPA, SEO proxy değil
    location ~ ^/magaza/([^/]+)/dukkan$ {
        rewrite ^ /pages/seller/seller-shop.html break;
    }

    location ~ ^/magaza/(.+)$ {
        error_page 418 = @seo_seller;
        if ($is_bot) { return 418; }
        rewrite ^ /pages/seller/seller-storefront.html break;
    }
    location @seo_seller {
        internal;
        rewrite ^/magaza/(.+)$ /api/method/tradehub_core.seo.page_resolver.render_seller?slug=$1 break;
        # Paylaşım önizlemesinde müşteri backend domaini görmesin (canonical/og:url → ${FRONTEND_DOMAIN}).
        proxy_set_header Accept-Encoding "";
        sub_filter "${BACKEND_DOMAIN}" "${FRONTEND_DOMAIN}";
        sub_filter_once off;
        proxy_hide_header X-Robots-Tag;
        proxy_set_header X-Istoc-Storefront "1";
        proxy_pass https://${BACKEND_DOMAIN};
        proxy_ssl_server_name on;
        proxy_set_header Host ${BACKEND_DOMAIN};
        proxy_set_header X-Country "";
        proxy_set_header CF-IPCountry "";
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
    }

    # ── Statik sayfa SEO → backend render_static_page (meta injection)
    # $seo_static_page_path map'te eşleşen path'ler buraya yönlendirilir.
    location @seo_static_backend {
        internal;
        rewrite ^ /api/method/tradehub_core.seo.page_resolver.render_static_page?path=$seo_static_page_path break;
        # Paylaşım önizlemesinde müşteri backend domaini görmesin (canonical/og:url → ${FRONTEND_DOMAIN}).
        proxy_set_header Accept-Encoding "";
        sub_filter "${BACKEND_DOMAIN}" "${FRONTEND_DOMAIN}";
        sub_filter_once off;
        proxy_hide_header X-Robots-Tag;
        proxy_set_header X-Istoc-Storefront "1";
        proxy_pass https://${BACKEND_DOMAIN};
        proxy_ssl_server_name on;
        proxy_set_header Host ${BACKEND_DOMAIN};
        proxy_set_header X-Country "";
        proxy_set_header CF-IPCountry "";
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
    }

    # Statik medya (logo, PWA ikonları, görseller, font) — hash'siz ama nadiren
    # değişir. 30 gün cache + revalidation; HTML bu bloğa girmez (uzantı eşleşmesi).
    location ~* \.(?:png|jpg|jpeg|webp|gif|ico|svg|woff2?|ttf)$ {
        add_header Cache-Control "public, max-age=2592000";
        add_header X-Robots-Tag $robots_tag always;
        try_files $uri @frappe_assets;
    }

    # ──────────────────────────────────────────
    # Admin Panel SPA (/panel) — birleşik container'da (örn. PROD/istoc) admin'i
    # aynı container'dan serve eder. Ayrı-container ortamlarda (beta/rc) /panel
    # zaten upstream'de (gateway) ayrı admin'e yönlenir → bu blok erişilmez/zararsız.
    # ^~ ZORUNLU: /panel/assets/*.js|css yukarıdaki resim/asset regex'lerine düşmesin.
    # ──────────────────────────────────────────
    location ^~ /panel {
        alias /usr/share/nginx/html/panel;
        try_files $uri $uri/ /panel/index.html;
    }

    # Frontend statik dosyalar
    # Bot isteklerinde (Googlebot vb.) statik sayfalar backend'e proxy edilir
    # (SEO meta injection). Normal kullanıcılar dist'ten doğrudan sunulur.
    # Dinamik SEO (/urun/, /kategori/, /marka/, /magaza/) yukarıdaki ayrı
    # location blokları ile her zaman backend'e gider — etkilenmez.
    location / {
        error_page 418 = @seo_static_backend;
        if ($is_bot) {
            set $seo_bot_route $seo_static_page_path;
        }
        if ($seo_bot_route != "") {
            return 418;
        }
        try_files $resolved_page $uri/ $uri.html =404;
    }

    error_page 404 /404.html;
}
